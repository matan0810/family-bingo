// Firestore security rules for family-bingo (project family-bingo-4c8e7).
// Deploy: paste into Firebase Console -> Firestore -> Rules -> Publish.
// Replace FAMILY_CODE with the real family code before publishing (the code is kept out of this public repo).
// FAMILY_CODE is only the fallback: once a founder sets a code in the app (config/secret), that one is used.
// No player names here: players, founders (fixed) and admins live in config/settings. Admins are also the raters.
// Trust model: anyone who entered the family code is a trusted family member.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // ---- game settings ----
    function settingsDoc() { return /databases/$(db)/documents/config/settings; }
    function settings() { return get(settingsDoc()).data; }
    function players() { return exists(settingsDoc()) ? settings().players : []; }
    function secretDoc() { return /databases/$(db)/documents/config/secret; }
    function familyCode() { return exists(secretDoc()) ? get(secretDoc()).data.code : 'FAMILY_CODE'; }
    function d() { return request.resource.data; }
    function settingsOk() {
      return d().keys().hasOnly(['title', 'players', 'founders', 'admins'])
        && d().title is string && d().title.size() <= 40
        && d().players is list && d().players.size() >= 2 && d().players.size() <= 12
        && d().founders is list && d().founders.size() >= 1 && d().players.hasAll(d().founders)
        && d().admins is list && d().players.hasAll(d().admins);
    }

    // ---- who is asking: a device (members/{uid}) that holds a name (players/{name}.uid) ----
    function signedIn() { return request.auth != null; }
    function memberDoc() { return /databases/$(db)/documents/members/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(memberDoc()); }
    // one get() and no exists(): a missing doc just fails the check. Rules allow only 10 document
    // reads per request and exists()/get() on the same doc count separately, so keep these lean.
    function owns(name) {
      return isMember() && name is string && name.size() > 0
        && get(/databases/$(db)/documents/players/$(name)).data.uid == request.auth.uid;
    }
    // the name this device holds (recorded in members/{uid}.name when it picks a name, verified by owns)
    function myName() { return get(memberDoc()).data.get('name', ''); }
    function iAm() { return isMember() && owns(myName()); }
    // settings always exist once seeded; without them there are no founders or admins anyway
    function isFounder() { return iAm() && myName() in settings().founders; }
    function isAdmin() { return isFounder() || (iAm() && myName() in settings().admins); }

    // ---- game phase: entry -> rate -> play -> ended ----
    function stateDoc() { return /databases/$(db)/documents/game/state; }
    function state() { return get(stateDoc()).data; }
    function status() { return exists(stateDoc()) ? state().status : 'entry'; }
    function isEntry() { return status() == 'entry'; }
    // the admins (founders included) are the raters; game/state.raters from older versions is ignored
    function isRater() { return isAdmin(); }
    function textOk(t) { return t is string && t.size() > 0 && t.size() <= 140; }
    // who a prediction is about: a list (empty = a general event); older predictions hold a single name.
    // The first name is the subject, the rest are involved; the rules treat them all the same.
    function aboutOf(a) { return a is list ? a : [a]; }
    // a timestamp field may be missing, null, set now, or left unchanged
    function tsOk(f) {
      return !(f in d()) || d()[f] == null || d()[f] == request.time
        || (resource != null && f in resource.data && d()[f] == resource.data[f]);
    }

    // one doc per device; created with the right family code; later records the name it holds
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && d().keys().hasOnly(['code']) && d().code == familyCode();
      allow update: if signedIn() && request.auth.uid == uid
        && d().diff(resource.data).affectedKeys().hasOnly(['name'])
        && d().name is string
        && getAfter(/databases/$(db)/documents/players/$(d().name)).data.uid == request.auth.uid;
    }

    // title, players, founders, admins. Any member may create it once (the app seeds it from the
    // existing game); after that only founders change it, and the founders themselves never change.
    match /config/settings {
      allow read: if isMember();
      allow create: if isMember() && !exists(settingsDoc()) && settingsOk();
      allow update: if isFounder() && settingsOk() && d().founders == resource.data.founders;
    }

    // the family code; only founders read or change it
    match /config/secret {
      allow read: if isFounder();
      allow write: if isFounder() && d().keys().hasOnly(['code'])
        && d().code is string && d().code.size() >= 3 && d().code.size() <= 40;
    }

    // players/{name} = {uid}: which device holds each name.
    // Any member may take a name over (the app asks "is this you?" first).
    match /players/{name} {
      allow read: if isMember();
      allow create, update: if isMember() && name in players()
        && d().keys().hasOnly(['uid']) && d().uid == request.auth.uid;
      allow delete: if owns(name) || isAdmin();
    }

    // items/{id}: who a prediction is about and who wrote it (no text), readable by all members.
    // about = [] for a general event, or [subject, ...involved]; never the author.
    match /items/{id} {
      allow read: if isMember();
      allow create: if isEntry()
        && id.matches('^[A-Za-z0-9]{20}$')
        && existsAfter(/databases/$(db)/documents/texts/$(id))
        && d().keys().hasOnly(['about', 'author', 'weight', 'at'])
        && d().about is list && d().about.size() <= 12 && players().hasAll(d().about)
        && owns(d().author) && !(d().author in d().about)
        && d().weight == 1
        && d().at == request.time;
      allow delete: if isEntry() && (isAdmin() || owns(resource.data.author));
    }

    // texts/{id} = {text}: the author always; raters during the rating phase; everyone during the game
    // except anyone it is about; once the game has ended, everyone (the reveal). The author may edit it until rating ends.
    match /texts/{id} {
      function meta() { return get(/databases/$(db)/documents/items/$(id)).data; }
      allow get: if isMember() && (status() == 'ended' || owns(meta().author) || (iAm() && !(myName() in aboutOf(meta().about)) && (
        status() == 'play' || (status() == 'rate' && isRater()))));
      allow create: if isEntry()
        && d().keys().hasOnly(['text']) && textOk(d().text)
        && owns(getAfter(/databases/$(db)/documents/items/$(id)).data.author);
      allow update: if status() in ['entry', 'rate'] && owns(meta().author)
        && d().keys().hasOnly(['text']) && textOk(d().text);
      allow delete: if isEntry() && (isAdmin() || owns(meta().author));
    }

    // suggestions/{id}: a rater proposes better wording; only the author's device (toUid) and the
    // rater's (fromUid) can see it, never anyone it is about. The author accepts by editing the text.
    match /suggestions/{id} {
      function it() { return get(/databases/$(db)/documents/items/$(d().item)).data; }
      allow create: if status() == 'rate'
        && d().keys().hasOnly(['item', 'from', 'fromUid', 'toUid', 'text', 'at'])
        && d().item is string && textOk(d().text) && d().at == request.time
        && d().fromUid == request.auth.uid && d().from == myName() && isRater()
        && !(d().from in aboutOf(it().about)) && it().author != d().from
        && d().toUid == get(/databases/$(db)/documents/players/$(it().author)).data.uid;
      allow read, delete: if isMember()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    match /game/{docId} {
      allow read: if isMember();
      allow write: if docId == 'state' && isAdmin()
        && d().keys().hasOnly(['status', 'cards', 'size', 'win', 'raters', 'raterUids', 'at'])
        && d().status in ['entry', 'rate', 'play', 'ended']
        && d().cards is map && d().cards.keys().hasOnly(players())
        && (!('size' in d()) || d().size in [2, 3, 4, 5])
        && (!('win' in d()) || d().win in ['full', 'line'])
        && (!('raters' in d()) || (d().raters is list && d().raters.hasOnly(players())));
    }

    match /marks/{p} {
      allow read: if isMember();
      allow write: if p in players() && ((owns(p) && status() == 'play') || isAdmin())
        && d().keys().hasOnly(['marked', 'bingo', 'blackout', 'bingoAt', 'blackoutAt'])
        && d().marked is list && d().marked.size() <= 25
        && d().bingo is bool && d().blackout is bool
        && tsOk('bingoAt') && tsOk('blackoutAt');
    }

    // events/{item}_{player} = {item, player, at}: when a player marked a cell (for the trip journal and the
    // end-of-game awards). The owner writes it with the mark and deletes it on unmark; admins clear them with the cards.
    match /events/{eid} {
      allow read: if isMember();
      allow create, update: if status() == 'play' && owns(d().player)
        && d().keys().hasOnly(['item', 'player', 'at'])
        && d().item is string && eid == d().item + '_' + d().player && d().at == request.time;
      allow delete: if isAdmin() || (status() == 'play' && owns(resource.data.player));
    }

    // looks/{player} = {e}: the player's chosen emoji (must match EMOJIS in js/config.js)
    match /looks/{p} {
      allow read: if isMember();
      allow write: if p in players() && (owns(p) || isAdmin())
        && d().keys().hasOnly(['e'])
        && d().e in ['🦁', '🦄', '🐬', '🐸', '🐙', '🐢', '🦊', '🐼', '🐯', '🐨',
          '🐷', '🐵', '🐧', '🦉', '🐝', '🦋', '🐞', '🦖', '🐳', '🦩',
          '🐱', '🐰', '🦈', '🌵', '🍕', '🍉', '🚀', '👽', '🤖', '👻'];
    }

    // ratings/{item}_{player} = {item, player, stars}: only admins (the raters), only in the rating phase,
    // never on a prediction they are in or wrote
    match /ratings/{rid} {
      function item() { return get(/databases/$(db)/documents/items/$(d().item)).data; }
      allow read: if isMember();
      allow create, update: if status() == 'rate'
        && d().keys().hasOnly(['item', 'player', 'stars'])
        && d().item is string && rid == d().item + '_' + d().player
        && d().player == myName() && isRater()
        && d().stars in [0, 1, 2, 3]
        && !(d().player in aboutOf(item().about)) && item().author != d().player;
      allow delete: if isAdmin();
    }

    // history/{id}: results of finished games
    match /history/{id} {
      allow read: if isMember();
      allow create: if isAdmin()
        && d().keys().hasOnly(['at', 'size', 'title', 'results', 'prophets'])
        && d().at == request.time && d().size in [2, 3, 4, 5]
        && (!('title' in d()) || (d().title is string && d().title.size() <= 40))
        && d().results is list && d().results.size() <= 12
        && (!('prophets' in d()) || (d().prophets is list && d().prophets.size() <= 12));
      allow delete: if isAdmin();
    }
    // anything not matched above is denied
  }
}
